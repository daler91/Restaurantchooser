# Postgres connection string. On Railway, the Postgres plugin provides this
# automatically as DATABASE_URL. For local dev, point at a local Postgres.
DATABASE_URL=postgres://user:password@localhost:5432/restaurantchooser

# PIN required to unlock the Admin tab in the UI and to pass the
# x-admin-pin header for admin API routes. Keep this secret in production.
ADMIN_PIN=1234

# Optional: enables the legacy Google Places live lookup in the client.
# Leave empty to use DB-only mode.
GOOGLE_PLACES_API_KEY=
